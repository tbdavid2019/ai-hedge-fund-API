# ===============================
# LLM Configuration & Default Model
# ===============================

# Default model when not specified in API request
DEFAULT_MODEL=gpt-4o
# Default provider: OpenAI, Anthropic, Gemini, DeepSeek, Groq (optional, auto-inferred if empty)
DEFAULT_MODEL_PROVIDER=OpenAI

# ===============================
# LLM API Keys (at least one required)
# ===============================

# OpenAI API Key (for gpt-4o, gpt-4o-mini, o1, o3-mini, gpt-4.5)
OPENAI_API_KEY=your-openai-api-key

# Optional Custom OpenAI-Compatible Base URL (e.g. OneAPI, NewAPI, Local Ollama, proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API Key (for claude-3-7-sonnet, claude-3-5-sonnet, claude-3-5-haiku)
ANTHROPIC_API_KEY=

# Groq API Key (for llama-3.3-70b, deepseek-r1-distill)
GROQ_API_KEY=

# Gemini API Key (for gemini-2.0-flash, gemini-2.0-pro)
GEMINI_API_KEY=

# DeepSeek Native API Key (for deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=

# ===============================
# REQUIRED: Financial Data APIs (Free)
# ===============================

# Alpha Vantage API Key (Required - Primary data source)
ALPHA_VANTAGE_API_KEY=

# Additional Data Sources (Optional but recommended)
STOCKDATA_API_KEY=
FINNHUB_API_KEY=
EODHD_API_KEY=

# ===============================
# OPTIONAL: Reddit API (for WSB agent; falls back to 2md search if empty)
# ===============================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai_hedge_fund:v2.0

# Crypto API Keys (Optional)
COINGECKO_API_KEY=
CRYPTOCOMPARE_API_KEY=

# ===============================
# OPTIONAL: Discord Webhook Notification
# ===============================
DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=