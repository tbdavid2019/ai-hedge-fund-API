# ===============================
# LLM Configuration & Default Model
# ===============================

# Primary default model: Google Gemini models/gemini-flash-latest
DEFAULT_MODEL=models/gemini-flash-latest
DEFAULT_MODEL_PROVIDER=Gemini

# Gemini API Configuration (Primary & Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Fallback LLM (Gemini models/gemini-flash-latest)
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_MODEL=models/gemini-flash-latest
FALLBACK_API_KEY=your_gemini_api_key_here

# 2MD Search Engine Endpoints (Primary & Backups)
TWOMD_PRIMARY_URL=https://2md.aiurl.tw
TWOMD_BACKUP1_URL=https://2md.glsoft.ai
TWOMD_BACKUP2_URL=https://create360.ai

# Anthropic API Key (for claude-3-7-sonnet, claude-3-5-sonnet, claude-3-5-haiku)
ANTHROPIC_API_KEY=

# Groq API Key (for llama-3.3-70b, deepseek-r1-distill)
GROQ_API_KEY=

# Gemini API Key (for gemini-2.0-flash, gemini-2.0-pro)
GEMINI_API_KEY=

# DeepSeek Native API Key (for deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=

# ===============================
# REQUIRED: Financial Data APIs (Free)
# ===============================

# Alpha Vantage API Key (Required - Primary data source)
ALPHA_VANTAGE_API_KEY=

# Additional Data Sources (Optional but recommended)
STOCKDATA_API_KEY=
FINNHUB_API_KEY=
EODHD_API_KEY=

# ===============================
# OPTIONAL: Reddit API (for WSB agent; falls back to 2md search if empty)
# ===============================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai_hedge_fund:v2.0

# Crypto API Keys (Optional)
COINGECKO_API_KEY=
CRYPTOCOMPARE_API_KEY=

# ===============================
# OPTIONAL: Discord Webhook Notification
# ===============================
DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=