{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Hedge Fund API",
    "description": "AI 驅動的頂級投資分析 API，整合 16 位投資大師風格、多輪圓桌辯論會議、即時新聞社群情緒與多模型 LLM 支援。",
    "version": "2.0.0",
    "contact": {
      "name": "AI Hedge Fund API",
      "url": "https://github.com/tbdavid2019/ai-hedge-fund-API"
    }
  },
  "servers": [
    {
      "url": "https://hedgeapi.afpicapital.com",
      "description": "生產環境 HTTPS 伺服器 (Production HTTPS Server)"
    },
    {
      "url": "/",
      "description": "當前瀏覽器相對路徑 (Current Origin Server)"
    },
    {
      "url": "http://localhost:6000",
      "description": "本地開發伺服器 (Local Development Server)"
    }
  ],
  "paths": {
    "/api/analysis/async": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "非同步建立股票分析任務",
        "description": "建立非同步股票分析任務，立即回傳 taskId 與 pollUrl，避免 HTTP 閘道器逾時。可透過 GET /api/task/{taskId} 輪詢執行進度與最終決策。",
        "operationId": "runAnalysisAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "任務建立成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncTaskCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "請求格式錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/task/{task_id}": {
      "get": {
        "tags": [
          "Analysis"
        ],
        "summary": "查詢非同步任務狀態與結果",
        "description": "依據 taskId 查詢背景分析任務的執行狀態（pending、running、completed、error）及產出的投資分析訊號與委員會共識決策。",
        "operationId": "getTaskStatus",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "非同步任務唯一識別碼 (UUID)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查詢成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncTaskStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "任務不存在或已過期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/analysis": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "執行股票分析與圓桌會議",
        "description": "使用指定的 AI 分析師對股票進行全方位投資分析，並可選擇啟用多輪圓桌會議辯論達成共識決策。",
        "operationId": "runAnalysis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              },
              "examples": {
                "round_table_debate": {
                  "summary": "多輪圓桌會議完整分析",
                  "value": {
                    "tickers": "TSLA,NVDA",
                    "selectedAnalysts": [
                      "warren_buffett",
                      "cathie_wood",
                      "michael_burry",
                      "wsb",
                      "technical_analyst"
                    ],
                    "enableRoundTable": true,
                    "roundTableRounds": 2
                  }
                },
                "single_stock": {
                  "summary": "單一股票分析",
                  "value": {
                    "tickers": "TSLA",
                    "selectedAnalysts": [
                      "warren_buffett",
                      "peter_lynch",
                      "michael_burry"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "分析成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "請求格式錯誤，包含未知或格式錯誤的 selectedAnalysts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "伺服器錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/round_table": {
      "post": {
        "tags": [
          "Round Table"
        ],
        "summary": "獨立執行多輪圓桌會議辯論",
        "description": "傳入各分析師預先分析之訊號，進行多輪跨流派交鋒辯論並生成最終委員會共識決策。",
        "operationId": "runRoundTable",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoundTableRequest"
              },
              "example": {
                "tickers": "NVDA",
                "analystSignals": {
                  "warren_buffett": {
                    "NVDA": {
                      "signal": "neutral",
                      "confidence": 60,
                      "reasoning": "強大護城河但估值偏高"
                    }
                  },
                  "cathie_wood": {
                    "NVDA": {
                      "signal": "bullish",
                      "confidence": 90,
                      "reasoning": "AI 算力基礎設施爆發式增長"
                    }
                  },
                  "michael_burry": {
                    "NVDA": {
                      "signal": "bearish",
                      "confidence": 75,
                      "reasoning": "客戶資本支出可持續性存疑，估值過熱"
                    }
                  }
                },
                "modelName": "gpt-4o",
                "numRounds": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "圓桌會議完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "round_table": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "健康檢查",
        "description": "檢查 API 伺服器是否正常運行",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "伺服器正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "version": {
                      "type": "string",
                      "example": "2.0.0"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/backtest/grid": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "Run or resume a synchronized point-in-time backtest grid",
        "operationId": "runBacktestGrid",
        "description": "Persists point-in-time source snapshots and resumable daily portfolio sessions in SQLite. Defaults to a shared UTC cutoff, daily rebalancing, 0.10% transaction fees and 0.05% slippage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BacktestGridRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run result or resumed result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, including malformed or unknown selectedAnalysts keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Run failure"
          }
        }
      }
    },
    "/api/backtest/runs/{run_id}": {
      "get": {
        "tags": [
          "Analysis"
        ],
        "summary": "Get a backtest run manifest and saved result",
        "operationId": "getBacktestRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved run"
          },
          "404": {
            "description": "Run not found"
          }
        }
      }
    },
    "/api/stock/resolve": {
      "get": {
        "tags": [
          "Stock Tools"
        ],
        "summary": "智慧解析單一股票代號與公司檔案",
        "description": "智慧解析股票代號（例如台股 2330 -> 2330.TW、美股 SPCX、港股 700 -> 0700.HK）與官方中英文檔案。",
        "operationId": "resolveStockGet",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "股票代碼或公司名稱 (如 2330, TSLA, 騰訊, SPCX)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "解析成功"
          }
        }
      },
      "post": {
        "tags": [
          "Stock Tools"
        ],
        "summary": "批次或單筆解析股票代號",
        "description": "傳入多筆股票代號或查詢字串陣列進行批次解析標準化代號。",
        "operationId": "resolveStockPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tickers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "2330",
                      "TSLA",
                      "SPCX",
                      "700"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "解析成功"
          }
        }
      }
    },
    "/api/stock/registry/status": {
      "get": {
        "tags": [
          "Stock Tools"
        ],
        "summary": "查詢全球股票清冊快取與 SWR 更新狀態",
        "description": "查詢包含台、美、港、陸、日、歐、英全球 32,000+ 檔標的之離線快取狀態與非同步背景更新進度。",
        "operationId": "getRegistryStatus",
        "responses": {
          "200": {
            "description": "查詢成功"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "type": "object",
        "required": [
          "tickers",
          "modelName"
        ],
        "properties": {
          "tickers": {
            "type": "string",
            "description": "股票代碼，多個用逗號分隔，例如 TSLA,NVDA,2330",
            "example": "TSLA,NVDA"
          },
          "selectedAnalysts": {
            "type": "array",
            "description": "分析師 key 陣列，必須來自 analyst registry；未知 key 或非陣列值會在工作開始前回 HTTP 400。空陣列表示使用全部 16 位分析師。",
            "items": {
              "type": "string",
              "enum": [
                "ben_graham",
                "bill_ackman",
                "cathie_wood",
                "charlie_munger",
                "michael_burry",
                "peter_lynch",
                "phil_fisher",
                "nancy_pelosi",
                "warren_buffett",
                "wsb",
                "technical_analyst",
                "fundamentals_analyst",
                "sentiment_analyst",
                "valuation_analyst",
                "stanley_druckenmiller",
                "decision_model"
              ]
            }
          },
          "modelName": {
            "type": "string",
            "description": "使用的 LLM 模型名稱，例如 clef-flash, clef-flash-q4, openai/gpt-oss-20b, models/gemini-flash-latest, gpt-4o",
            "default": "openai/gpt-oss-20b",
            "example": "clef-flash"
          },
          "modelProvider": {
            "type": "string",
            "description": "LLM 提供商（TypeSafe, Groq, Gemini, OpenAI 等），若傳入 clef-flash 系列將自動推斷為 TypeSafe",
            "example": "TypeSafe"
          },
          "enableRoundTable": {
            "type": "boolean",
            "description": "是否在分析師分析後啟用多輪圓桌會議辯論",
            "default": false,
            "example": true
          },
          "roundTableRounds": {
            "type": "integer",
            "description": "圓桌會議辯論輪數（建議 2 或 3）",
            "default": 2,
            "example": 2
          },
          "initialCash": {
            "type": "number",
            "description": "可選初始投資金額（預設 100000.0），亦相容 initial_cash, initialCapital, capital, cash 別名。此金額直接用於風控模型（Risk Manager）計算部位上限與建議下單股數 (recommended_shares)。",
            "default": 100000,
            "example": 100000
          },
          "portfolio": {
            "type": "object",
            "description": "Optional explicit portfolio snapshot. Its cash overrides initialCash. Snapshot dates more than 7 days before endDate are rejected. Cross-currency positions require a Yahoo Finance historical FX close available by as_of.",
            "required": [
              "as_of",
              "cash",
              "currency",
              "positions"
            ],
            "properties": {
              "as_of": {
                "type": "string",
                "format": "date",
                "description": "Portfolio snapshot date; must not be after endDate and must be no more than 7 days old."
              },
              "cash": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Za-z]{3}$",
                "description": "ISO 4217 cash currency."
              },
              "positions": {
                "type": "array",
                "description": "An empty array means the portfolio is explicitly flat.",
                "items": {
                  "type": "object",
                  "required": [
                    "ticker",
                    "quantity",
                    "average_entry_price",
                    "currency"
                  ],
                  "properties": {
                    "ticker": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "number",
                      "description": "Signed shares: positive is long; negative is short."
                    },
                    "average_entry_price": {
                      "type": "number",
                      "minimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Za-z]{3}$",
                      "description": "ISO 4217 trading currency."
                    }
                  }
                }
              }
            },
            "example": {
              "as_of": "2026-09-24",
              "cash": 50000,
              "currency": "USD",
              "positions": [
                {
                  "ticker": "AAPL",
                  "quantity": 10,
                  "average_entry_price": 180,
                  "currency": "USD"
                }
              ]
            }
          },
          "pointInTime": {
            "type": "boolean",
            "default": false,
            "description": "Enable strict historical data filtering. Records without verified publication/availability times are excluded and reported in point_in_time coverage."
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "分析起始日期（YYYY-MM-DD）"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "分析結束日期（YYYY-MM-DD）"
          }
        }
      },
      "RoundTableRequest": {
        "type": "object",
        "required": [
          "tickers"
        ],
        "properties": {
          "tickers": {
            "type": "string",
            "description": "標的代號"
          },
          "analystSignals": {
            "type": "object",
            "description": "各分析師預先計算之訊號"
          },
          "modelName": {
            "type": "string",
            "default": "gpt-4o"
          },
          "numRounds": {
            "type": "integer",
            "default": 2
          }
        }
      },
      "AnalysisResponse": {
        "type": "object",
        "properties": {
          "decisions": {
            "type": "object",
            "description": "最終投資組合決策"
          },
          "analyst_signals": {
            "type": "object",
            "description": "各分析師的獨立分析訊號"
          },
          "point_in_time": {
            "type": "object",
            "description": "Present when pointInTime=true; includes the decision cutoff, source coverage, exclusions, and current-universe survivorship-bias disclosure."
          },
          "round_table": {
            "type": "object",
            "description": "多輪圓桌會議辯論與共識結論"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "錯誤訊息"
          },
          "traceback": {
            "type": "string",
            "description": "錯誤堆疊追蹤"
          }
        }
      },
      "BacktestGridRequest": {
        "type": "object",
        "required": [
          "runId",
          "tickers",
          "startDate",
          "endDate"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$"
          },
          "tickers": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "cutoffTimeUtc": {
            "type": "string",
            "default": "16:00:00Z"
          },
          "selectedAnalysts": {
            "$ref": "#/components/schemas/AnalysisRequest/properties/selectedAnalysts"
          },
          "initialCash": {
            "type": "number",
            "minimum": 0,
            "default": 100000
          },
          "portfolio": {
            "$ref": "#/components/schemas/AnalysisRequest/properties/portfolio"
          },
          "dailyRebalancePolicy": {
            "type": "string",
            "enum": [
              "daily",
              "none"
            ],
            "default": "daily"
          },
          "transactionFeeRate": {
            "type": "number",
            "minimum": 0,
            "default": 0.001
          },
          "slippageRate": {
            "type": "number",
            "minimum": 0,
            "default": 0.0005
          },
          "marginRatio": {
            "type": "number",
            "minimum": 0,
            "default": 0.5
          }
        }
      },
      "AsyncTaskCreatedResponse": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "example": "c7a840e6-8575-408f-8898-dbe3234d7d0a"
          },
          "status": {
            "type": "string",
            "example": "pending"
          },
          "message": {
            "type": "string",
            "example": "AI 分析任務已在背景建立，請透過 /api/task/<taskId> 查詢進度與結果"
          },
          "pollUrl": {
            "type": "string",
            "example": "/api/task/c7a840e6-8575-408f-8898-dbe3234d7d0a"
          },
          "tickers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "2330.TW"
            ]
          }
        }
      },
      "AsyncTaskStatusResponse": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "error"
            ]
          },
          "progress": {
            "type": "string"
          },
          "tickers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "$ref": "#/components/schemas/AnalysisResponse"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Analysis",
      "description": "股票分析與決策 API"
    },
    {
      "name": "Round Table",
      "description": "多輪圓桌會議辯論 API"
    },
    {
      "name": "Stock Tools",
      "description": "全球股票代碼解析與清冊管理"
    },
    {
      "name": "Health",
      "description": "伺服器健康檢查"
    }
  ]
}
